# ---------------------------------------------------------------------------- #
# Inception — environment configuration                                        #
#                                                                              #
# NON-SECRET configuration only. Passwords live in ../secrets/*.txt and are    #
# injected through docker-compose secrets (mounted at /run/secrets/...).       #
#                                                                              #
# Replace "login" with your intra username everywhere.                         #
# ---------------------------------------------------------------------------- #

# Domain that will point to your local IP address (see /etc/hosts).
DOMAIN_NAME=login.42.fr

# ---------------------------------------------------------------------------- #
# MariaDB (database name and application user — not the passwords)             #
# ---------------------------------------------------------------------------- #
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wpdbuser

# ---------------------------------------------------------------------------- #
# WordPress                                                                     #
# ---------------------------------------------------------------------------- #
# Administrator username: must NOT contain admin/Admin/administrator/
# Administrator (subject rule).
WP_ADMIN_USER=supervisor
WP_ADMIN_EMAIL=supervisor@login.42.fr

# Second WordPress user (required by the subject: 2 users in the database).
WP_USER=editor_user
WP_USER_EMAIL=editor@login.42.fr

# Title shown on the website.
WP_TITLE=Inception
